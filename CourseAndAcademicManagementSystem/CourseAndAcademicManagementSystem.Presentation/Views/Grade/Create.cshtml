@model CAMS.BusinessLogic.ViewModels.GradeViewModels.CreatedGradeViewModel

@{
    ViewBag.Title = "Add Grade";
}

<div class="container mt-4">
    <h2>Add New Grade</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="SessionId" class="form-label">Session</label>
            <select asp-for="SessionId" class="form-select" asp-items="Model.Sessions">
                <option value="">-- Select Session --</option>
            </select>
            <span asp-validation-for="SessionId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TraineeId" class="form-label">Trainee</label>
            <select asp-for="TraineeId" class="form-select" asp-items="Model.Trainees">
                <option value="">-- Select Trainee --</option>
            </select>
            <span asp-validation-for="TraineeId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Value" class="form-label">Grade Value</label>
            <input asp-for="Value" class="form-control" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Weight" class="form-label">Weight</label>
            <input asp-for="Weight" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="AttemptNumber" class="form-label">Attempt Number</label>
            <input asp-for="AttemptNumber" class="form-control" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsFinal" class="form-check-input" type="checkbox" />
            <label asp-for="IsFinal" class="form-check-label">Is Final</label>
        </div>

        <div class="mb-3">
            <label asp-for="Comments" class="form-label">Comments</label>
            <textarea asp-for="Comments" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
    </form>
</div>
