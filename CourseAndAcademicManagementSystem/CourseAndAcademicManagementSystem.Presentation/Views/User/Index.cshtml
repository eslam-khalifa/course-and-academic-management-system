@model IEnumerable<UserViewModel>

@{
    ViewBag.Title = "Users Management";
}

<h2 class="mb-4">Users Management</h2>

<!-- Alert Messages -->
<partial name="_alert" />

<!-- Search Form -->
<form method="get" asp-action="Index" class="form-inline mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control mr-2" placeholder="Search by name" />

    <select name="searchRole" class="form-control mr-2">
        <option value="">-- All Roles --</option>
        @foreach (var role in ViewBag.Roles as List<string>)
        {
            <option value="@role">@role</option>
        }
    </select>

    <button type="submit" class="btn btn-primary mr-2">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Reset</a>
</form>

<!-- Create Button -->
<a asp-action="Create" class="btn btn-success mb-3">Create New User</a>

<!-- Users Table -->
<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>#</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Phone</th>
            <th>Status</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            foreach (var user in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Role == "Admin")
                        {
                            <span class="badge badge-danger">Admin</span>
                        }
                        else if (user.Role == "Instructor")
                        {
                            <span class="badge badge-primary">Instructor</span>
                        }
                        else
                        {
                            <span class="badge badge-info">Student</span>
                        }
                    </td>
                    <td>@user.PhoneNumber</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="DeleteUser(@user.UserId)">Delete</button>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No users found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-search="@ViewBag.Search" asp-route-searchRole="@ViewBag.SearchRole">«</a>
            </li>
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-searchRole="@ViewBag.SearchRole">‹</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@ViewBag.Search" asp-route-searchRole="@ViewBag.SearchRole">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-searchRole="@ViewBag.SearchRole">›</a>
            </li>
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@ViewBag.TotalPages" asp-route-search="@ViewBag.Search" asp-route-searchRole="@ViewBag.SearchRole">»</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/js/delete.js"></script>
}
