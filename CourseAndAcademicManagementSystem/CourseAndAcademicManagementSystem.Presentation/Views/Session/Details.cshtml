@model CAMS.BusinessLogic.ViewModels.SessionViewModels.SessionDetailsViewModel

@{
    ViewData["Title"] = "Session Details";
}

<div class="container mt-4">
    <h2 class="mb-4">Session Details</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">

                <!-- Course -->
                <dt class="col-sm-3">Course</dt>
                <dd class="col-sm-9">@Model.Course?.Name (@Model.Course?.Code)</dd>

                <!-- Title -->
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <!-- Session Code -->
                <dt class="col-sm-3">Session Code</dt>
                <dd class="col-sm-9">@Model.SessionCode</dd>

                <!-- Start Date -->
                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd HH:mm")</dd>

                <!-- End Date -->
                <dt class="col-sm-3">End Date</dt>
                <dd class="col-sm-9">@Model.EndDate.ToString("yyyy-MM-dd HH:mm")</dd>

                <!-- Enrollment Start Date -->
                <dt class="col-sm-3">Enrollment Start</dt>
                <dd class="col-sm-9">
                    @(Model.EnrollmentStartDate.HasValue
                                        ? Model.EnrollmentStartDate.Value.ToString("yyyy-MM-dd HH:mm")
                                        : "N/A")
                </dd>

                <!-- Enrollment End Date -->
                <dt class="col-sm-3">Enrollment End</dt>
                <dd class="col-sm-9">
                    @(Model.EnrollmentEndDate.HasValue
                                        ? Model.EnrollmentEndDate.Value.ToString("yyyy-MM-dd HH:mm")
                                        : "N/A")
                </dd>

                <!-- Location -->
                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@(!string.IsNullOrEmpty(Model.Location) ? Model.Location : "N/A")</dd>

                <!-- Capacity -->
                <dt class="col-sm-3">Capacity</dt>
                <dd class="col-sm-9">@(Model.Capacity.HasValue? Model.Capacity.ToString() : "N/A")</dd>

                <!-- Instructor -->
                <dt class="col-sm-3">Instructor</dt>
                <dd class="col-sm-9">@Model.Instructor?.DisplayName</dd>

                <!-- Status -->
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">@Model.Status</span>
                </dd>

                <!-- Mode -->
                <dt class="col-sm-3">Mode</dt>
                <dd class="col-sm-9">@(!string.IsNullOrEmpty(Model.Mode) ? Model.Mode : "N/A")</dd>

                <!-- Created At -->
                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                <!-- Created By -->
                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.CreatedBy</dd>

                <!-- Updated At -->
                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">
                    @(Model.UpdatedAt.HasValue
                                        ? Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                        : "N/A")
                </dd>

            </dl>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.SessionId" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.SessionId" class="btn btn-danger ms-2">
                <i class="bi bi-trash"></i> Delete
            </a>
        </div>
    </div>
</div>
