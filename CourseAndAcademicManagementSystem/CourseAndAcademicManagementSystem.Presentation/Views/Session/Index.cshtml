@model CAMS.BusinessLogic.ViewModels.SessionViewModels.SessionListViewModel

@{
    ViewData["Title"] = "Sessions List";
}

<!--Alert-->
<partial name="_alert" />
<!--Alert-->

<h2 class="mb-4">Sessions</h2>

<div class="mb-3">
    <form method="get" class="d-flex">
        <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by title" class="form-control me-2" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Session Code</th>
            <th>Title</th>
            <th>Course</th>
            <th>Instructor</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var session in Model.PagedCourses.Items)
        {
            <tr>
                <td>@session.SessionCode</td>
                <td>@session.Title</td>
                <td>@session.CourseName</td>
                <td>@session.InstructorName</td>
                <td>@session.StartDate.ToShortDateString()</td>
                <td>@session.EndDate.ToShortDateString()</td>
                <td>@session.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@session.SessionId" class="btn btn-sm btn-warning">Edit</a>
                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteSession(@session.SessionId)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary mt-3">Create New Session</a>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
