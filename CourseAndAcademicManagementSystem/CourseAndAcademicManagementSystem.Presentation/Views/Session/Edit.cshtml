@model CAMS.BusinessLogic.ViewModels.SessionViewModels.UpdatedSessionViewModel

@{
    ViewData["Title"] = "Edit Session";
}

<h2 class="mb-4">Edit Session</h2>

<form asp-action="Edit" method="post">
    <div class="card p-4 shadow-sm">
        <input type="hidden" asp-for="SessionId" />

        <!--partial-->
        <partial name="_SessionForm" model="Model" />

        <button type="submit" class="btn btn-success">Update</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
