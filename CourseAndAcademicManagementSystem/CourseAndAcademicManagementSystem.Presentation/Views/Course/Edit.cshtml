@model CreatedCourseViewModel

@{
    ViewData["Title"] = "Edit Course";
}

<h2 class="mb-4">Edit Course</h2>


<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
    <input type="hidden" asp-for="InstructorId" />
    <input type="hidden" asp-for="ThumbnailUrl" />

    <!--partial-->
    <partial name="_CourseForm" model="Model" />

    <div class="form-group mb-3">
        <label class="form-label">Current Thumbnail</label>
        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <div class="mb-2">
                <img src="~/@Model.ThumbnailUrl" alt="Course Thumbnail" class="img-thumbnail" style="max-width: 150px;" />
            </div>
        }
        else
        {
            <p class="text-muted">No image uploaded.</p>
        }

        <label class="form-label">Upload New Thumbnail</label>
        <input type="file" name="thumbnailFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
