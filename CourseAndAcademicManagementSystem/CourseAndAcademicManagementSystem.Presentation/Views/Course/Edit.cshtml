@model CreatedCourseViewModel

@{
    ViewData["Title"] = "Edit Course";
}

<h2 class="mb-4">Edit Course</h2>

<!-- عرض رسالة نجاح -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
    <input type="hidden" asp-for="InstructorId" />
    <input type="hidden" asp-for="ThumbnailUrl" />

    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="form-group mb-3 col-md-4">
            <label asp-for="Credits" class="form-label"></label>
            <input asp-for="Credits" class="form-control" type="number" />
            <span asp-validation-for="Credits" class="text-danger"></span>
        </div>

        <div class="form-group mb-3 col-md-4">
            <label asp-for="DurationHours" class="form-label"></label>
            <input asp-for="DurationHours" class="form-control" type="number" />
            <span asp-validation-for="DurationHours" class="text-danger"></span>
        </div>

        <div class="form-group mb-3 col-md-4">
            <label asp-for="MaxTrainees" class="form-label"></label>
            <input asp-for="MaxTrainees" class="form-control" type="number" />
            <span asp-validation-for="MaxTrainees" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="InstructorId" class="form-label">Instructor</label>
        <select asp-for="InstructorId" asp-items="Model.Instructors" class="form-control">
            <option value="">-- Select Instructor --</option>
        </select>
        <span asp-validation-for="InstructorId" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Is Active</label>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Current Thumbnail</label>
        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <div class="mb-2">
                <img src="~/@Model.ThumbnailUrl" alt="Course Thumbnail" class="img-thumbnail" style="max-width: 150px;" />
            </div>
        }
        else
        {
            <p class="text-muted">No image uploaded.</p>
        }

        <label class="form-label">Upload New Thumbnail</label>
        <input type="file" name="thumbnailFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
